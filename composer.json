{
  "name": "happyprime/happyprime.co",
  "type": "project",
  "minimum-stability": "stable",
  "require-dev": {
    "happyprime/coding-standards": "*",
    "phpcompatibility/php-compatibility": "dev-develop as 9.99.99"
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs",
    "phpcbf": "vendor/bin/phpcbf",
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=2048M",
    "lint": [
      "@lint:theme",
      "@lint:features"
    ],
    "lint:theme": "phpcs --basepath=. ./themes/happyprime.co -v",
    "lint:features": "phpcs --basepath=. ./mu-plugins/happyprime.co -v",
    "fix": [
      "@fix:theme",
      "@fix:features"
    ],
    "fix:theme": "phpcbf --basepath=. ./themes/happyprime.co -v",
    "fix:features": "phpcbf --basepath=. ./mu-plugins/happyprime.co -v"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "preferred-install": {
      "happyprime/*": "source",
      "*": "dist"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ]
}
